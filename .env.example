# Local database for Prisma. The UI demo can run in mock mode before connecting DB.
DATABASE_URL="postgresql://triproom:triproom@localhost:5432/triproom"

# mock keeps the MVP runnable without external travel API keys.
AI_ADAPTER_MODE="mock"
MODEL_PROVIDER="mock"
MODEL_NAME="mock-preference-v1"
MODEL_API_KEY=""
TRAVEL_PROVIDER="mock"
SPEECH_TO_TEXT_ADAPTER_MODE="mock"
VISION_EXTRACTION_ADAPTER_MODE="mock"
PRICE_ESTIMATE_ADAPTER_MODE="mock"

# Hackathon AI planning. Configure these on the server / Vercel only.
# For the public demo set MODEL_PROVIDER="deepseek".
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Optional AI/storage settings for later replacement. No travel API key is required for MVP.
OPENAI_API_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="triproom-uploads"
